---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "App Astro mínima para el demo de CI/CD con Claude." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="chrome-top"></div>

    <header class="site-header">
      <div class="container header-inner">
        <span class="brand-eyebrow">BOOTCAMPERU · CONFERENCIA</span>
        <span class="brand-mark">cicd-talk-demo</span>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>El uso de la IA generativa para crear flujos de CI/CD</span>
        <span>
          <a href="https://github.com/ScrambledBits/cicd-talk-demo" rel="noopener">
            github.com/ScrambledBits
          </a>
        </span>
      </div>
    </footer>

    <div class="chrome-bottom"></div>

    <style is:global>
      :root {
        --c-bg: #ffffff;
        --c-text: #0f172a;
        --c-text-soft: #334155;
        --c-muted: #64748b;
        --c-divider: #e2e8f0;
        --c-surface: #f8fafc;
        --c-t1: #0f766e;
        --c-t1-bg: #f0fdfa;
        --c-t1-soft: #ccfbf1;
        --c-t2: #c2410c;
        --c-t2-bg: #fff7ed;
        --c-t2-soft: #fed7aa;
        --font-title: Georgia, Cambria, "Times New Roman", serif;
        --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Calibri, sans-serif;
        --font-code: "SF Mono", Consolas, "Liberation Mono", Menlo, monospace;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--c-bg);
        color: var(--c-text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.55;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .container {
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .chrome-top,
      .chrome-bottom {
        height: 4px;
        width: 100%;
      }
      .chrome-top { background: var(--c-t1); }
      .chrome-bottom { background: var(--c-t2); margin-top: auto; }

      .site-header {
        background: var(--c-bg);
        border-bottom: 1px solid var(--c-divider);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        padding-bottom: 1rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand-eyebrow {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--c-t1);
        text-transform: uppercase;
      }
      .brand-mark {
        font-family: var(--font-code);
        font-size: 0.875rem;
        color: var(--c-muted);
      }

      main {
        flex: 1;
        padding-top: 3rem;
        padding-bottom: 4rem;
      }

      h1, h2, h3 {
        font-family: var(--font-title);
        color: var(--c-text);
        margin: 0 0 0.5rem;
        line-height: 1.15;
      }
      h1 { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 700; }
      h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; }
      h3 { font-size: 1.125rem; font-weight: 700; }

      p {
        margin: 0 0 1rem;
        color: var(--c-text-soft);
      }

      a {
        color: var(--c-t1);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      a:hover { color: var(--c-t2); }

      code, kbd, samp {
        font-family: var(--font-code);
        font-size: 0.92em;
        background: var(--c-surface);
        padding: 0.1em 0.35em;
        border-radius: 3px;
        color: var(--c-text);
      }

      .site-footer {
        background: var(--c-surface);
        border-top: 1px solid var(--c-divider);
        font-size: 0.875rem;
        color: var(--c-muted);
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        padding-bottom: 1rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-footer a { color: var(--c-muted); }
      .site-footer a:hover { color: var(--c-t1); }
    </style>
  </body>
</html>
